{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && node ./watch.mjs",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node --enable-source-maps ./dist/migrate.mjs",
    "seed": "node --enable-source-maps ./dist/seed.mjs"
  },
  "dependencies": {
    "@google-cloud/storage": "7.19.0",
    "@types/adm-zip": "0.5.8",
    "@types/compression": "1.8.1",
    "@types/qrcode": "1.5.6",
    "@undecaf/zbar-wasm": "0.11.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "adm-zip": "0.5.17",
    "compression": "1.8.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "drizzle-orm": "catalog:",
    "express": "5.1.0",
    "google-auth-library": "10.1.0",
    "ioredis": "5.6.1",
    "jimp": "1.6.0",
    "jsonwebtoken": "9.0.2",
    "jwks-rsa": "4.0.1",
    "mammoth": "1.9.0",
    "multer": "2.0.1",
    "openai": "6.6.0",
    "pdf-lib": "1.17.1",
    "pdf-parse": "1.1.1",
    "pdfkit": "0.16.0",
    "pino": "9.7.0",
    "pino-http": "10.4.0",
    "qrcode": "1.5.4",
    "resend": "6.0.0",
    "tesseract.js": "5.1.1",
    "ws": "8.18.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.1",
    "@types/jsonwebtoken": "9.0.9",
    "@types/multer": "1.4.12",
    "@types/node": "catalog:",
    "@types/pdf-parse": "1.1.4",
    "@types/pdfkit": "0.17.6",
    "@types/ws": "8.18.1",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "2.3.3",
    "pino-pretty": "13.0.0",
    "thread-stream": "3.1.0",
    "vitest": "^3.2.3"
  }
