# =============================================================================
# Sovereign Office — VM Production Environment
# Azure VM: 20.83.210.26
#
# INSTRUCTIONS:
#   1. Copy this file to .env on your Azure VM
#   2. Fill in the two FILL_IN values (see comments)
#   3. Run vm-bootstrap.sh
# =============================================================================

# ── Database — Azure PostgreSQL ───────────────────────────────────────────────
# Full connection string to your Azure PostgreSQL database.
# Format: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=<from-secret-store>
POSTGRES_PASSWORD=<from-secret-store>

# ── Security Keys ─────────────────────────────────────────────────────────────
# SESSION_SECRET: paste the full value from your Replit secrets panel
SESSION_SECRET=<from-secret-store>

# Internal service-to-service key
SERVICE_KEY=<from-secret-store>

# ── Server URLs ───────────────────────────────────────────────────────────────
# Replace sovereignoffice.org with your actual registered domain.
APP_URL=https://api.sovereignoffice.org
SOVEREIGN_DASHBOARD_URL=https://sovereign.sovereignoffice.org
TRUST_DASHBOARD_URL=https://trust.sovereignoffice.org
COMMUNITY_DASHBOARD_URL=https://community.sovereignoffice.org
ATLAS_DASHBOARD_URL=https://atlas.sovereignoffice.org

# ── Microsoft Entra ID (SSO) ──────────────────────────────────────────────────
AZURE_ENTRA_TENANT_ID=3b71074d-80fb-46a1-a481-3aed69152480
AZURE_ENTRA_CLIENT_ID=9d408980-8fbf-4384-a712-436e70480eb9
# ⚠️  FILL THIS IN — get the VALUE from Azure Portal → App Registrations →
#    Certificates & secrets → Value column (NOT the Secret ID / UUID)
AZURE_ENTRA_CLIENT_SECRET=<from-secret-store>

# ── Azure OpenAI ──────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# ── Azure Container Registry ──────────────────────────────────────────────────
ACR_REGISTRY=sovereignoffice.azurecr.io
ACR_LOGIN_SERVER=sovereignoffice.azurecr.io
ACR_USERNAME=sovereignoffice
ACR_PASSWORD=<from-secret-store>
IMAGE_TAG=latest

# ── Optional ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=production
