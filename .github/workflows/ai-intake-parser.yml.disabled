name: AI Intake Parser (Dry Run)

# ── TRIGGER ───────────────────────────────────────────────────────────────────
# Manual only for now. Do NOT change to `issues: [opened]` until dry-run
# testing is complete and the API endpoint is confirmed stable.
on:
  workflow_dispatch:
    inputs:
      issue_number:
        description: 'GitHub Issue number to parse (used if fetching from API)'
        required: false
        default: '0'
      issue_title:
        description: 'Issue title (leave blank to use built-in sample)'
        required: false
        default: ''
      issue_body:
        description: 'Issue body text (leave blank to use built-in sample)'
        required: false
        default: ''
      dry_run:
        description: 'Dry run — preview only, no DB writes'
        required: false
        default: 'true'
        type: choice
        options:
          - 'true'
          - 'false'

# ── PERMISSIONS ───────────────────────────────────────────────────────────────
permissions:
  issues: read
  contents: read

jobs:
  parse-intake:
    name: Parse Intake Issue
    runs-on: ubuntu-latest

    steps:
      # ── 1. Resolve issue content ────────────────────────────────────────────
      - name: Resolve issue content
        id: resolve
        env:
          INPUT_TITLE: ${{ github.event.inputs.issue_title }}
          INPUT_BODY:  ${{ github.event.inputs.issue_body }}
          GH_TOKEN:    ${{ secrets.GITHUB_TOKEN }}
          REPO:        ${{ github.repository }}
          ISSUE_NUM:   ${{ github.event.inputs.issue_number }}
        run: |
          TITLE="$INPUT_TITLE"
          BODY="$INPUT_BODY"

          # If no title provided, try to fetch from GitHub API
          if [ -z "$TITLE" ] && [ "$ISSUE_NUM" != "0" ] && [ -n "$GH_TOKEN" ]; then
            echo "Fetching issue #$ISSUE_NUM from GitHub API..."
            ISSUE_JSON=$(curl -s -H "Authorization: Bearer $GH_TOKEN" \
              "https://api.github.com/repos/$REPO/issues/$ISSUE_NUM")
            TITLE=$(echo "$ISSUE_JSON" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('title',''))")
            BODY=$(echo "$ISSUE_JSON" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('body',''))")
          fi

          # Fall back to built-in sample
          if [ -z "$TITLE" ]; then
            echo "Using built-in sample intake document"
            TITLE="[INTAKE] Land allotment dispute — Kern County parcel"
          
BODY=$(cat <<'EOF'
Matter Type: land

Urgency: high
Parties: John Running Bear, Bureau of Indian Affairs - Pacific Region
Deadline: 2026-07-01
State: CA
County: Kern

Document Text:

This matter concerns an unresolved allotment claim on trust land parcel APN 019-280-12
in Kern County, California. The petitioner, John Running Bear, asserts that a 2019
BIA determination incorrectly removed the parcel from trust status. Prior correspondence
with the BIA Pacific Region office (dated March 4, 2026) went unanswered.

Federal review under 25 CFR Part 151 may be required. ICWA does not directly apply.
Treaty rights under the 1851 Fort Tejon Treaty may be implicated.

Legal Flags:
- Trust land involved
- Federal review required
- Treaty rights implicated
- Involves enrolled member
EOF
)
          fi

          echo "ISSUE_TITLE=$TITLE" >> "$GITHUB_OUTPUT"
          # Write body to file to avoid env var length limits
          echo "$BODY" > /tmp/issue_body.txt
          echo "Body length: $(wc -c < /tmp/issue_body.txt) chars"

      # ── 2. Mock extraction (local, no Azure needed) ─────────────────────────
      - name: Mock AI extraction
        id: extract
        run: |
          python3 - <<'PYEOF'
          import re, json

          with open("/tmp/issue_body.txt") as f:
              body = f.read()

          title = "${{ steps.resolve.outputs.ISSUE_TITLE }}"
          combined = (title + " " + body).lower()

          # Matter type
          matter_type = "general"
          if any(w in combined for w in ["land","allotment","parcel","trust land","apn","acreage"]):
              matter_type = "land"
          elif any(w in combined for w in ["member","enrollment","blood","cdib","roll"]):
              matter_type = "membership"
          elif any(w in combined for w in ["child","welfare","icwa","foster","custody"]):
              matter_type = "child_welfare"
          elif any(w in combined for w in ["treaty","rights","sovereign"]):
              matter_type = "treaty_rights"
          elif any(w in combined for w in ["probate","estate","inheritance","decedent"]):
              matter_type = "probate"

          # Urgency
          urgency = "medium"
          if any(w in combined for w in ["urgent","emergency","immediate","high","critical"]):
              urgency = "high"
          elif any(w in combined for w in ["low priority","routine","low"]):
              urgency = "low"

          # Parties
          parties = []
          for pattern in [r"parties?:\s*([^\n]+)", r"against:\s*([^\n]+)", r"petitioner[,:\s]+([^\n]+)"]:
              m = re.search(pattern, body, re.IGNORECASE)
              if m:
                  parties.extend([p.strip() for p in m.group(1).split(",") if p.strip()])
          if not parties:
              parties = ["[Not detected — add 'Parties:' field to issue body]"]

          # Deadline
          deadline = None
          m = re.search(r"deadline:\s*([^\n]+)", body, re.IGNORECASE)
          if m:
              deadline = m.group(1).strip()

          # State / county
          state, county = None, None
          m = re.search(r"state:\s*([A-Z]{2})", body, re.IGNORECASE)
          if m: state = m.group(1).upper()
          m = re.search(r"county:\s*([^\n]+)", body, re.IGNORECASE)
          if m: county = m.group(1).strip()

          # Legal flags
          flags = []
          if any(w in combined for w in ["icwa","indian child welfare"]): flags.append("ICWA")
          if any(w in combined for w in ["trust land","trust status"]): flags.append("trust_land")
          if any(w in combined for w in ["federal review","cfr"]): flags.append("federal_review")
          if any(w in combined for w in ["treaty","25 usc","25 cfr"]): flags.append("treaty_rights")
          if any(w in combined for w in ["enrolled member","tribal member"]): flags.append("enrolled_member")

          # Instruments
          instruments = ["Complaint Filing"]
          if matter_type == "land": instruments.extend(["Notice of Trust Claim", "BIA Trust Determination Letter"])
          if matter_type == "child_welfare": instruments.extend(["ICWA Notice", "ICWA Intervention Motion"])
          if "treaty_rights" in flags: instruments.append("Treaty Rights Assertion")
          if "federal_review" in flags: instruments.append("Federal Review Request (25 CFR)")

          result = {
              "extractionMethod": "mock_parser_v1",
              "issueTitle": title,
              "matterType": matter_type,
              "urgency": urgency,
              "parties": parties,
              "deadline": deadline,
              "state": state,
              "county": county,
              "legalFlags": flags,
              "recommendedInstruments": instruments,
              "confidence": 0.65,
              "note": "Mock extraction — Azure OpenAI not used in this run",
          }

          with open("/tmp/extracted.json", "w") as f:
              json.dump(result, f, indent=2)

          print("=== EXTRACTED FIELDS ===")
          print(json.dumps(result, indent=2))
          PYEOF

      # ── 3. Call API (dry run) ───────────────────────────────────────────────
      - name: POST to /api/github/intake (dry run)
        id: api_call
        env:
          API_URL:     ${{ secrets.SOVEREIGN_API_URL }}
          SERVICE_KEY: ${{ secrets.SERVICE_KEY }}
          DRY_RUN:     ${{ github.event.inputs.dry_run }}
          ISSUE_NUM:   ${{ github.event.inputs.issue_number }}
          ISSUE_TITLE: ${{ steps.resolve.outputs.ISSUE_TITLE }}
          REPO:        ${{ github.repository }}
        run: |
          if [ -z "$API_URL" ]; then
            echo "⚠️  SOVEREIGN_API_URL secret not set — skipping API call (local dry run only)"
            echo "api_skipped=true" >> "$GITHUB_OUTPUT"
            exit 0
          fi

          EXTRACTED=$(cat /tmp/extracted.json)
          ISSUE_BODY=$(cat /tmp/issue_body.txt | head -c 8000)

          PAYLOAD=$(python3 -c "
          import json, sys
          extracted = json.loads('''$EXTRACTED''')
          payload = {
            'issueNumber': int('$ISSUE_NUM') if '$ISSUE_NUM' != '0' else None,
            'issueTitle': '$ISSUE_TITLE',
            'issueBody': open('/tmp/issue_body.txt').read()[:8000],
            'repository': '$REPO',
            'labels': ['intake', 'needs-review', extracted.get('matterType','general')],
            'dryRun': '$DRY_RUN' == 'true',
            'extracted': extracted,
          }
          print(json.dumps(payload))
          ")

          echo "Calling $API_URL/api/github/intake ..."
          RESPONSE=$(curl -s -w "\n%{http_code}" \
            -X POST "$API_URL/api/github/intake" \
            -H "Content-Type: application/json" \
            -H "X-Api-Key: $SERVICE_KEY" \
            -d "$PAYLOAD")

          HTTP_CODE=$(echo "$RESPONSE" | tail -1)
          BODY=$(echo "$RESPONSE" | head -n -1)

          echo "HTTP status: $HTTP_CODE"
          echo "=== API RESPONSE ==="
          echo "$BODY" | python3 -m json.tool 2>/dev/null || echo "$BODY"

          if [ "$HTTP_CODE" != "200" ] && [ "$HTTP_CODE" != "201" ]; then
            echo "::warning::API returned $HTTP_CODE"
          fi

      # ── 4. Summary ─────────────────────────────────────────────────────────
      - name: Print run summary
        run: |
          echo ""
          echo "════════════════════════════════════════════"
          echo "   INTAKE PIPELINE — DRY RUN COMPLETE"
          echo "════════════════════════════════════════════"
          echo ""
          echo "Mode:       DRY RUN (no DB writes)"
          echo "Extraction: mock_parser_v1 (Azure OpenAI not used)"
          echo ""
          cat /tmp/extracted.json | python3 -m json.tool
          echo ""
          echo "Next steps when ready to go live:"
          echo "  1. Set SOVEREIGN_API_URL secret in repo settings"
          echo "  2. Set SERVICE_KEY secret in repo settings"
          echo "  3. Add Azure OpenAI extraction step"
          echo "  4. Change trigger from workflow_dispatch → issues: [opened]"
          echo "  5. Set dryRun=false in production calls"
          echo ""

